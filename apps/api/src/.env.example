PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinicworks
DB_USER=clinicworks
DB_PASSWORD=changeme

# Azure Blob Storage
# Local dev (Azurite): use the connection string from .env
# Azure deployment: replace with the real connection string from Azure Portal
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<key>;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=documents